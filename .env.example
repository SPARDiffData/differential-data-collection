# Copy this file to .env and fill in your own values.
# .env is gitignored and stays on your computer. Never commit real values,
# and never paste them into an Issue, PR or chat.
# Nothing reads these yet; the first feature Issues will.

# DIS-6: direct Slack API access (later; for now Claude's Slack connector does discovery)
SLACK_TOKEN=

# COL-4: the Google Docs sign-in doesn't use .env. Its client file goes in
# ~/.diffdata/google-client.json, outside the repo, and the sign-in is saved beside it.
